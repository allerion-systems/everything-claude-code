# Required for address -> lat/lon
MAPBOX_TOKEN=

# Optional - enables Google Photorealistic 3D Tiles provider
# Get one at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Optional - Cesium ion access for terrain (defaults to public Mapbox terrain)
CESIUM_ION_TOKEN=

# Public URL where viewer.html is served (used to build MCP App responses)
PUBLIC_VIEWER_URL=http://localhost:8787

# HTTP port for the static viewer server
VIEWER_PORT=8787
