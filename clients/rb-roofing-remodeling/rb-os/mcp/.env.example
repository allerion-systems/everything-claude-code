# RB-OS MCP server configuration. Copy to .env and fill in.

# Anthropic API key (the Agency runs on Claude Managed Agents).
ANTHROPIC_API_KEY=sk-ant-...

# IDs printed by agency/scripts/provision.sh
RB_AGENCY_COORDINATOR_ID=agent_...
RB_AGENCY_ENVIRONMENT_ID=env_...

# Optional: the Brain mounted as shared memory for every session.
# Create a memory store from the brain/ vault, then put its ID here.
RB_BRAIN_MEMORY_STORE_ID=memstore_...
