# Required: Google Cloud API key with these APIs enabled:
#   - Geocoding API
#   - Maps Static API
#   - Street View Static API
#   - Solar API
GOOGLE_MAPS_API_KEY=your-google-api-key

# Required: Anthropic key for Claude vision (used to count openings / identify components).
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: override the Claude model used for vision (default: claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6
