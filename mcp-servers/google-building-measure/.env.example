# ─────────────────────────────────────────────────────────────────
# REQUIRED: Google API key
# Enable these APIs in console.cloud.google.com:
#   Geocoding API, Maps Static API, Street View Static API,
#   Solar API, Aerial View API
# ─────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-api-key


# ─────────────────────────────────────────────────────────────────
# VISION PROVIDER — pick ONE of the three options below
# ─────────────────────────────────────────────────────────────────

# ── OPTION 1: Google Gemini Flash (FREE — RECOMMENDED) ───────────
# Get a free key in 30 seconds at https://aistudio.google.com
# Free tier: 15 requests/min, 1 million tokens/day
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash   # default, change to gemini-1.5-flash if needed


# ── OPTION 2: Ollama — 100% local, no internet, no cost ──────────
# 1. Download Ollama at https://ollama.ai
# 2. Run in terminal: ollama pull llama3.2-vision
# 3. Uncomment the two lines below:
# VISION_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2-vision
# OLLAMA_HOST=http://localhost:11434   # default, only change if you moved the port


# ── OPTION 3: Anthropic Claude (paid, highest accuracy) ──────────
# Get key at https://console.anthropic.com
# ~$0.01-0.05 per report
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-6
